target triple = "x86_64-pc-windows-msvc"

define i32 @both(i32 %arg0) {
entry:
  %_0 = alloca i32
  %_1 = alloca i32
  %_2 = alloca i32
  store i32 %arg0, ptr %_1
  br label %bb0

bb0:
  %t0 = icmp ne i32 1, 0
  %t1 = zext i1 %t0 to i32
  store i32 %t1, ptr %_2
  %t2 = load i32, ptr %_2
  %t3 = icmp ne i32 %t2, 0
  br i1 %t3, label %bb2, label %bb1

bb1:
  %t4 = load i32, ptr %_2
  store i32 %t4, ptr %_0
  %t5 = load i32, ptr %_0
  ret i32 %t5

bb2:
  %t6 = load i32, ptr %_1
  %t7 = icmp ne i32 %t6, 0
  %t8 = zext i1 %t7 to i32
  store i32 %t8, ptr %_2
  br label %bb1
}

define i32 @main() {
entry:
  %_0 = alloca i32
  %_1 = alloca i32
  br label %bb0

bb0:
  store i32 0, ptr %_0
  %t0 = call i32 @both(i32 2)
  store i32 %t0, ptr %_1
  br label %bb1

bb1:
  %t1 = load i32, ptr %_1
  store i32 %t1, ptr %_0
  %t2 = load i32, ptr %_0
  ret i32 %t2
}
