bb3:
  br label %bb4

bb4:
  br label %bb5

bb5:
  %t16 = load i8, ptr %_3
  %t17 = sext i8 %t16 to i32
  %t18 = icmp slt i32 %t17, 5
  %t19 = zext i1 %t18 to i32
  store i32 %t19, ptr %_12
  %t20 = load i32, ptr %_12
  %t21 = icmp ne i32 %t20, 0
