target triple = "x86_64-unknown-linux-gnu"

declare signext i8 @twice(i8 signext)

define signext i8 @use_it(i8 signext %arg0) {
entry:
  %_0 = alloca i8
  %_1 = alloca i8
  %_2 = alloca i8
  store i8 %arg0, ptr %_1
  br label %bb0

bb0:
  %t0 = load i8, ptr %_1
  %t1 = call signext i8 @twice(i8 signext %t0)
  store i8 %t1, ptr %_2
  br label %bb1

bb1:
  %t2 = load i8, ptr %_2
  store i8 %t2, ptr %_0
  %t3 = load i8, ptr %_0
  ret i8 %t3
}
