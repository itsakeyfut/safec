target triple = "x86_64-pc-windows-msvc"
@g = global i32 zeroinitializer
@table = global <{ ptr, i8, [7 x i8], i64, ptr, i8, [39 x i8] }> <{ ptr @.str.0, i8 1, [7 x i8] zeroinitializer, i64 2, ptr @.str.1, i8 3, [39 x i8] zeroinitializer }>, align 8
@at = global ptr @g
@.str.0 = internal constant [2 x i8] c"a\00"
@.str.1 = internal constant [3 x i8] c"bc\00"
