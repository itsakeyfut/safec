target triple = "x86_64-unknown-linux-gnu"

declare i32 @takes(i64, i64, ...)

declare { i64, i64 } @makes(i32, ...)

declare i32 @fixed_parameter(i64, i64)

declare i64 @returned()


define internal ptr @".memcpy"(ptr %0, ptr %1, i64 %2) alwaysinline {
  call void @llvm.memcpy.p0.p0.i64(ptr %0, ptr %1, i64 %2, i1 false)
  ret ptr %0
}
declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)
