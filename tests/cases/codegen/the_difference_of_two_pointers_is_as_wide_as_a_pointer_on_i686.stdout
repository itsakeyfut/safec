target triple = "i686-unknown-linux-gnu"

define i64 @apart(ptr %arg0, ptr %arg1) {
entry:
  %_0 = alloca i64
  %_1 = alloca ptr
  %_2 = alloca ptr
  %_3 = alloca i32
  store ptr %arg0, ptr %_1
  store ptr %arg1, ptr %_2
  br label %bb0

bb0:
  %t0 = load ptr, ptr %_2
  %t1 = load ptr, ptr %_1
  %t2 = ptrtoint ptr %t0 to i32
  %t3 = ptrtoint ptr %t1 to i32
  %t4 = sub i32 %t2, %t3
  %t5 = sdiv i32 %t4, 4
  store i32 %t5, ptr %_3
  %t6 = load i32, ptr %_3
  %t7 = sext i32 %t6 to i64
  store i64 %t7, ptr %_0
  %t8 = load i64, ptr %_0
  ret i64 %t8
}
