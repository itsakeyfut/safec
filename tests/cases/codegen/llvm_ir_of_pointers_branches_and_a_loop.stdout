target triple = "x86_64-pc-windows-msvc"

define void @bump(ptr %arg0) {
entry:
  %_1 = alloca ptr
  %_2 = alloca i32
  store ptr %arg0, ptr %_1
  br label %bb0

bb0:
  %t0 = load ptr, ptr %_1
  %t1 = load i32, ptr %t0
  %t2 = add nsw i32 %t1, 1
  store i32 %t2, ptr %_2
  %t3 = load i32, ptr %_2
  %t4 = load ptr, ptr %_1
  store i32 %t3, ptr %t4
  ret void
}

define i32 @main() {
entry:
  %_0 = alloca i32
  %_1 = alloca i32
  %_2 = alloca ptr
  %_3 = alloca i8
  %_4 = alloca ptr
  %_5 = alloca i32
  %_6 = alloca i32
  %_7 = alloca i32
  %_8 = alloca i32
  %_9 = alloca i32
  br label %bb0

bb0:
  store i32 0, ptr %_0
  store i32 40, ptr %_1
  store ptr %_1, ptr %_4
  %t0 = load ptr, ptr %_4
  store ptr %t0, ptr %_2
  %t1 = load ptr, ptr %_2
  call void @bump(ptr %t1)
  br label %bb1

bb1:
  store i8 2, ptr %_3
  %t2 = load i32, ptr %_1
  %t3 = icmp sgt i32 %t2, 40
  %t4 = zext i1 %t3 to i32
  store i32 %t4, ptr %_5
  %t5 = load i32, ptr %_5
  %t6 = icmp ne i32 %t5, 0
  br i1 %t6, label %bb2, label %bb3

bb2:
  %t7 = load i8, ptr %_3
  %t8 = sext i8 %t7 to i32
  %t9 = add nsw i32 %t8, 1
  store i32 %t9, ptr %_6
  %t10 = load i32, ptr %_6
  %t11 = trunc i32 %t10 to i8
  store i8 %t11, ptr %_3
  br label %bb4

bb3:
  br label %bb4

bb4:
  br label %bb5

bb5:
  %t12 = load i8, ptr %_3
  %t13 = sext i8 %t12 to i32
  %t14 = icmp slt i32 %t13, 5
  %t15 = zext i1 %t14 to i32
  store i32 %t15, ptr %_7
  %t16 = load i32, ptr %_7
  %t17 = icmp ne i32 %t16, 0
  br i1 %t17, label %bb6, label %bb7

bb6:
  %t18 = load i8, ptr %_3
  %t19 = sext i8 %t18 to i32
  %t20 = add nsw i32 %t19, 1
  store i32 %t20, ptr %_8
  %t21 = load i32, ptr %_8
  %t22 = trunc i32 %t21 to i8
  store i8 %t22, ptr %_3
  br label %bb5

bb7:
  %t23 = load ptr, ptr %_2
  %t24 = load i32, ptr %t23
  %t25 = load i8, ptr %_3
  %t26 = sext i8 %t25 to i32
  %t27 = add nsw i32 %t24, %t26
  store i32 %t27, ptr %_9
  %t28 = load i32, ptr %_9
  store i32 %t28, ptr %_0
  %t29 = load i32, ptr %_0
  ret i32 %t29
}
