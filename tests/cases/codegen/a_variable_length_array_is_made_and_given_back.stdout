target triple = "x86_64-unknown-linux-gnu"

define i32 @sized(i32 %arg0) {
entry:
  %_0 = alloca i32
  %_1 = alloca i32
  %_2 = alloca i32
  %_3 = alloca i64
  %_4 = alloca ptr
  %_saved4 = alloca ptr
  %_5 = alloca ptr
  %_6 = alloca ptr
  %_7 = alloca i64
  %_8 = alloca i32
  %_9 = alloca i32
  store i32 %arg0, ptr %_1
  br label %bb0

bb0:
  store i32 0, ptr %_2
  %t0 = load i32, ptr %_1
  %t1 = sext i32 %t0 to i64
  store i64 %t1, ptr %_3
  %t2 = call ptr @llvm.stacksave.p0()
  store ptr %t2, ptr %_saved4
  %t3 = load i64, ptr %_3
  %t4 = mul i64 %t3, 1
  %t5 = alloca i8, i64 %t4, align 1
  store ptr %t5, ptr %_4
  %t6 = load ptr, ptr %_4
  store ptr %t6, ptr %_5
  %t7 = load ptr, ptr %_5
  store i8 1, ptr %t7
  %t8 = load ptr, ptr %_4
  store ptr %t8, ptr %_6
  %t9 = load i64, ptr %_3
  %t10 = mul i64 %t9, 1
  store i64 %t10, ptr %_7
  %t11 = load i64, ptr %_7
  %t12 = trunc i64 %t11 to i32
  store i32 %t12, ptr %_8
  %t13 = load ptr, ptr %_6
  %t14 = load i8, ptr %t13
  %t15 = sext i8 %t14 to i32
  %t16 = load i32, ptr %_8
  %t17 = add nsw i32 %t15, %t16
  store i32 %t17, ptr %_9
  %t18 = load i32, ptr %_9
  store i32 %t18, ptr %_2
  %t19 = load ptr, ptr %_saved4
  call void @llvm.stackrestore.p0(ptr %t19)
  %t20 = load i32, ptr %_2
  store i32 %t20, ptr %_0
  %t21 = load i32, ptr %_0
  ret i32 %t21
}

declare ptr @llvm.stacksave.p0()
declare void @llvm.stackrestore.p0(ptr)
