target triple = "x86_64-pc-windows-msvc"
@.str.0 = private unnamed_addr constant [6 x i8] c"A\0A\22q\5C\00"
@.str.1 = private unnamed_addr constant [3 x i8] c"ab\00"

define i32 @main() {
entry:
  %_0 = alloca i32
  %_1 = alloca ptr
  %_2 = alloca ptr
  %_3 = alloca ptr
  %_4 = alloca ptr
  %_5 = alloca ptr
  %_6 = alloca ptr
  %_7 = alloca ptr
  %_8 = alloca i32
  br label %bb0

bb0:
  store i32 0, ptr %_0
  store ptr @.str.0, ptr %_2
  %t0 = load ptr, ptr %_2
  store ptr %t0, ptr %_3
  %t1 = load ptr, ptr %_3
  store ptr %t1, ptr %_1
  store ptr @.str.1, ptr %_5
  %t2 = load ptr, ptr %_5
  store ptr %t2, ptr %_6
  %t3 = load ptr, ptr %_6
  store ptr %t3, ptr %_4
  %t4 = load ptr, ptr %_4
  %t5 = getelementptr i8, ptr %t4, i64 1
  store ptr %t5, ptr %_7
  %t6 = load ptr, ptr %_1
  %t7 = load i8, ptr %t6
  %t8 = sext i8 %t7 to i32
  %t9 = load ptr, ptr %_7
  %t10 = load i8, ptr %t9
  %t11 = sext i8 %t10 to i32
  %t12 = add nsw i32 %t8, %t11
  store i32 %t12, ptr %_8
  %t13 = load i32, ptr %_8
  store i32 %t13, ptr %_0
  %t14 = load i32, ptr %_0
  ret i32 %t14
}
