  %_8 = alloca [24 x i8], align 8
  %_9 = alloca ptr
  %_10 = alloca ptr
  %_11 = alloca ptr
  %_12 = alloca i64
  br label %bb0

bb0:
  store ptr @make, ptr %_1
  store ptr @sum, ptr %_2
  store ptr %_4, ptr %_5
  %t0 = load ptr, ptr %_1
  %t1 = load ptr, ptr %_5
  call void %t0(ptr sret([24 x i8]) align 8 %t1, i64 1)
