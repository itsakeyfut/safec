define i64 @an_address_as_an_integer() {
entry:
  %_0 = alloca i64
  %_1 = alloca i64
  br label %bb0

bb0:
  %t0 = ptrtoint ptr @two to i64
  store i64 %t0, ptr %_1
  %t1 = load i64, ptr %_1
  store i64 %t1, ptr %_0
  %t2 = load i64, ptr %_0
