target triple = "x86_64-unknown-linux-gnu"

declare void @make(ptr sret([24 x i8]) align 8, i64)

declare i64 @sum(ptr byval([24 x i8]) align 8)

define i64 @through_pointers() {
entry:
  %_0 = alloca i64
  %_1 = alloca ptr
  %_2 = alloca ptr
  %_3 = alloca [24 x i8], align 8
  %_4 = alloca [24 x i8], align 8
  %_5 = alloca ptr
  %_6 = alloca ptr
  %_7 = alloca ptr
  %_8 = alloca [24 x i8], align 8
  %_9 = alloca ptr
  %_10 = alloca ptr
  %_11 = alloca ptr
  %_12 = alloca i64
  br label %bb0

bb0:
  store ptr @make, ptr %_1
  store ptr @sum, ptr %_2
  store ptr %_4, ptr %_5
  %t0 = load ptr, ptr %_1
  %t1 = load ptr, ptr %_5
  call void %t0(ptr sret([24 x i8]) align 8 %t1, i64 1)
  br label %bb1

bb1:
  store ptr %_3, ptr %_6
  store ptr %_4, ptr %_7
  %t2 = load ptr, ptr %_6
  %t3 = load ptr, ptr %_7
  %t4 = call ptr @memcpy(ptr %t2, ptr %t3, i64 24)
  br label %bb2

bb2:
  store ptr %_8, ptr %_9
  store ptr %_3, ptr %_10
  %t5 = load ptr, ptr %_9
  %t6 = load ptr, ptr %_10
  %t7 = call ptr @memcpy(ptr %t5, ptr %t6, i64 24)
  br label %bb3

bb3:
  store ptr %_8, ptr %_11
  %t8 = load ptr, ptr %_2
  %t9 = load ptr, ptr %_11
  %t10 = call i64 %t8(ptr byval([24 x i8]) align 8 %t9)
  store i64 %t10, ptr %_12
  br label %bb4

bb4:
  %t11 = load i64, ptr %_12
  store i64 %t11, ptr %_0
  %t12 = load i64, ptr %_0
  ret i64 %t12
}

declare ptr @memcpy(ptr, ptr, i64)
