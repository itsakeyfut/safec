  %t13 = load ptr, ptr %_10
  call void @llvm.va_end.p0(ptr %t13)
  br label %bb2

bb2:
  %t14 = load i64, ptr %_6
  %t15 = trunc i64 %t14 to i32
  store i32 %t15, ptr %_11
  %t16 = load i32, ptr %_4
  %t17 = load i32, ptr %_11
  %t18 = add nsw i32 %t16, %t17
  store i32 %t18, ptr %_12
  %t19 = load ptr, ptr %_8
