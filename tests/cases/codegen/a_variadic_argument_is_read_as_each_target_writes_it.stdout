  %t21 = zext i1 %t20 to i32
  store i32 %t21, ptr %_13
  %t22 = load i32, ptr %_12
  %t23 = load i32, ptr %_13
  %t24 = add nsw i32 %t22, %t23
  store i32 %t24, ptr %_14
  %t25 = load i32, ptr %_14
