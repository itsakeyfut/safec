target triple = "x86_64-pc-windows-msvc"
@before = global i8 zeroinitializer
@global = global [16 x i8] zeroinitializer, align 8
@between = global i8 zeroinitializer
@many = global [2 x [16 x i8]] zeroinitializer, align 8

define i32 @main() {
entry:
  %_0 = alloca i32
  %_1 = alloca [16 x i8], align 8
  %_2 = alloca ptr
  %_3 = alloca ptr
  %_4 = alloca ptr
  %_5 = alloca ptr
  %_6 = alloca ptr
  %_7 = alloca ptr
  %_8 = alloca ptr
  %_9 = alloca ptr
  %_10 = alloca ptr
  %_11 = alloca ptr
  %_12 = alloca ptr
  %_13 = alloca ptr
  br label %bb0

bb0:
  store i32 0, ptr %_0
  store ptr %_1, ptr %_2
  %t0 = load ptr, ptr %_2
  %t1 = getelementptr i8, ptr %t0, i64 8
  store ptr %t1, ptr %_3
  %t2 = load ptr, ptr %_3
  store i64 1, ptr %t2
  store ptr @global, ptr %_4
  %t3 = load ptr, ptr %_4
  %t4 = getelementptr i8, ptr %t3, i64 8
  store ptr %t4, ptr %_5
  store ptr %_1, ptr %_6
  %t5 = load ptr, ptr %_6
  %t6 = getelementptr i8, ptr %t5, i64 8
  store ptr %t6, ptr %_7
  %t7 = load ptr, ptr %_7
  %t8 = load i64, ptr %t7
  %t9 = load ptr, ptr %_5
  store i64 %t8, ptr %t9
  store ptr @many, ptr %_8
  %t10 = load ptr, ptr %_8
  store ptr %t10, ptr %_9
  %t11 = load ptr, ptr %_9
  %t12 = getelementptr [16 x i8], ptr %t11, i64 1
  store ptr %t12, ptr %_10
  %t13 = load ptr, ptr %_10
  %t14 = getelementptr i8, ptr %t13, i64 8
  store ptr %t14, ptr %_11
  store ptr @global, ptr %_12
  %t15 = load ptr, ptr %_12
  %t16 = getelementptr i8, ptr %t15, i64 8
  store ptr %t16, ptr %_13
  %t17 = load ptr, ptr %_13
  %t18 = load i64, ptr %t17
  %t19 = load ptr, ptr %_11
  store i64 %t18, ptr %t19
  store i32 0, ptr %_0
  %t20 = load i32, ptr %_0
  ret i32 %t20
}
