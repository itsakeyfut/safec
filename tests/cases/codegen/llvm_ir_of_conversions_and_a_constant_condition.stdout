bb4:
  %t10 = load i32, ptr %_1
  %t11 = load i32, ptr %_5
  %t12 = add nsw i32 %t10, %t11
  store i32 %t12, ptr %_6
  %t13 = load i32, ptr %_6
  store i32 %t13, ptr %_1
  %t14 = load i32, ptr %_1
