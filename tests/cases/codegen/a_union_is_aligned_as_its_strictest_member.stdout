target triple = "x86_64-pc-windows-msvc"
@global = global [8 x i8] zeroinitializer, align 8
@table = internal global [2 x [8 x i8]] zeroinitializer, align 8

define i64 @read() {
entry:
  %_0 = alloca i64
  %_1 = alloca [8 x i8], align 8
  %_2 = alloca ptr
  %_3 = alloca ptr
  %_4 = alloca ptr
  %_5 = alloca ptr
  %_6 = alloca ptr
  %_7 = alloca ptr
  %_8 = alloca ptr
  %_9 = alloca ptr
  %_10 = alloca i64
  %_11 = alloca ptr
  %_12 = alloca ptr
  br label %bb0

bb0:
  store ptr %_1, ptr %_2
  %t0 = load ptr, ptr %_2
  %t1 = getelementptr i8, ptr %t0, i64 0
  store ptr %t1, ptr %_3
  store ptr @global, ptr %_4
  %t2 = load ptr, ptr %_4
  %t3 = getelementptr i8, ptr %t2, i64 0
  store ptr %t3, ptr %_5
  store ptr @table, ptr %_6
  %t4 = load ptr, ptr %_6
  store ptr %t4, ptr %_7
  %t5 = load ptr, ptr %_7
  %t6 = getelementptr [8 x i8], ptr %t5, i64 1
  store ptr %t6, ptr %_8
  %t7 = load ptr, ptr %_8
  %t8 = getelementptr i8, ptr %t7, i64 0
  store ptr %t8, ptr %_9
  %t9 = load ptr, ptr %_5
  %t10 = load i64, ptr %t9
  %t11 = load ptr, ptr %_9
  %t12 = load i64, ptr %t11
  %t13 = add nsw i64 %t10, %t12
  store i64 %t13, ptr %_10
  %t14 = load i64, ptr %_10
  %t15 = load ptr, ptr %_3
  store i64 %t14, ptr %t15
  store ptr %_1, ptr %_11
  %t16 = load ptr, ptr %_11
  %t17 = getelementptr i8, ptr %t16, i64 0
  store ptr %t17, ptr %_12
  %t18 = load ptr, ptr %_12
  %t19 = load i64, ptr %t18
  store i64 %t19, ptr %_0
  %t20 = load i64, ptr %_0
  ret i64 %t20
}
