target triple = "x86_64-unknown-linux-gnu"

define i64 @f(i32 %arg0, i32 %arg1) {
entry:
  %_0 = alloca i64
  %_1 = alloca i32
  %_2 = alloca i32
  %_3 = alloca ptr
  %_4 = alloca ptr
  %_5 = alloca ptr
  %_6 = alloca ptr
  %_7 = alloca i64
  %_8 = alloca i64
  %_9 = alloca i64
  store i32 %arg0, ptr %_1
  store i32 %arg1, ptr %_2
  br label %bb0

bb0:
  %t0 = load i32, ptr %_1
  %t1 = sext i32 %t0 to i64
  %t2 = inttoptr i64 %t1 to ptr
  store ptr %t2, ptr %_4
  %t3 = load ptr, ptr %_4
  store ptr %t3, ptr %_3
  %t4 = load i32, ptr %_2
  %t5 = zext i32 %t4 to i64
  %t6 = inttoptr i64 %t5 to ptr
  store ptr %t6, ptr %_6
  %t7 = load ptr, ptr %_6
  store ptr %t7, ptr %_5
  %t8 = load ptr, ptr %_3
  %t9 = ptrtoint ptr %t8 to i64
  store i64 %t9, ptr %_7
  %t10 = load ptr, ptr %_5
  %t11 = ptrtoint ptr %t10 to i64
  store i64 %t11, ptr %_8
  %t12 = load i64, ptr %_7
  %t13 = load i64, ptr %_8
  %t14 = add nsw i64 %t12, %t13
  store i64 %t14, ptr %_9
  %t15 = load i64, ptr %_9
  store i64 %t15, ptr %_0
  %t16 = load i64, ptr %_0
  ret i64 %t16
}
