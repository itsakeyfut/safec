error[SC0411]: `*n` may be read before anything was assigned to it
   ╭─[ a_heap_block_element_written_and_then_copied_over_unwritten_is_doubted_where_read.c:3:139 ]
   │
 3 │ int *f(int * _Nonnull x) { int **m = malloc(8); if (!m) return 0; int **n = malloc(16); if (!n) return 0; n[0] = x; memcpy(n, m, 8); int *r = n[0]; return r; }
   │                                                                                                                                           ────┬───  
   │                                                                                                                                               ╰───── read here
