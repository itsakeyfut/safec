target triple = "x86_64-unknown-linux-gnu"
@a = internal global ptr null
@b = global ptr null

define i32 @main() {
entry:
  %_0 = alloca i32
  %_1 = alloca ptr
  %_2 = alloca i32
  %_3 = alloca i32
  %_4 = alloca ptr
  %_5 = alloca i32
  br label %bb0

bb0:
  store i32 0, ptr %_0
  store ptr @a, ptr %_1
  %t0 = load ptr, ptr %_1
  %t1 = load ptr, ptr %t0
  %t2 = icmp ne ptr %t1, null
  %t3 = zext i1 %t2 to i32
  store i32 %t3, ptr %_2
  %t4 = load i32, ptr %_2
  %t5 = icmp ne i32 %t4, 0
  %t6 = zext i1 %t5 to i32
  store i32 %t6, ptr %_3
  %t7 = load i32, ptr %_3
  %t8 = icmp ne i32 %t7, 0
  br i1 %t8, label %bb1, label %bb2

bb1:
  %t9 = load i32, ptr %_3
  store i32 %t9, ptr %_0
  %t10 = load i32, ptr %_0
  ret i32 %t10

bb2:
  store ptr @b, ptr %_4
  %t11 = load ptr, ptr %_4
  %t12 = load ptr, ptr %t11
  %t13 = icmp ne ptr %t12, null
  %t14 = zext i1 %t13 to i32
  store i32 %t14, ptr %_5
  %t15 = load i32, ptr %_5
  %t16 = icmp ne i32 %t15, 0
  %t17 = zext i1 %t16 to i32
  store i32 %t17, ptr %_3
  br label %bb1
}
